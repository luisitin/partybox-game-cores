{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "phase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "move",
            "done"
          ]
        },
        "startedAt": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000000
        },
        "deadline": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "paused": {
          "type": "object",
          "properties": {
            "at": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000
            }
          },
          "required": [
            "at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "startedAt",
        "deadline"
      ],
      "additionalProperties": false
    },
    "phaseClock": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "rng": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seed",
        "step"
      ],
      "additionalProperties": false
    },
    "players": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarId": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "bot": {
            "type": "boolean"
          },
          "canSeeTv": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "avatarId",
          "connected"
        ],
        "additionalProperties": false
      }
    },
    "order": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "settings": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "american",
            "international"
          ]
        },
        "drawPolicy": {
          "type": "string",
          "enum": [
            "official",
            "fortyMove"
          ]
        },
        "repetition": {
          "type": "boolean"
        },
        "turnSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      },
      "required": [
        "variant",
        "drawPolicy",
        "repetition",
        "turnSeconds"
      ],
      "additionalProperties": false
    },
    "board": {
      "minItems": 32,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -2,
        "maximum": 2
      }
    },
    "variant": {
      "type": "string",
      "enum": [
        "american",
        "international"
      ]
    },
    "side": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": -1
        }
      ]
    },
    "quietPlies": {
      "type": "integer",
      "minimum": 0,
      "maximum": 80
    },
    "ply": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repetition": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      }
    },
    "drawWindows": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sixteen",
              "five",
              "diagonalFive"
            ]
          },
          "weak": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": -1
              }
            ]
          },
          "started": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "anyOf": [
              {
                "type": "number",
                "const": 10
              },
              {
                "type": "number",
                "const": 32
              }
            ]
          }
        },
        "required": [
          "kind",
          "weak",
          "started",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    "lastMove": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "playerId": {
              "type": "string"
            },
            "move": {
              "type": "object",
              "properties": {
                "path": {
                  "minItems": 2,
                  "maxItems": 21,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 49
                  }
                },
                "captures": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 49
                  }
                },
                "promotes": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "captures",
                "promotes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "playerId",
            "move"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "moveLog": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "playerId": {
            "type": "string"
          },
          "move": {
            "type": "object",
            "properties": {
              "path": {
                "minItems": 2,
                "maxItems": 21,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49
                }
              },
              "captures": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 49
                }
              },
              "promotes": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "captures",
              "promotes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "playerId",
          "move"
        ],
        "additionalProperties": false
      }
    },
    "left": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autoPaused": {
      "type": "boolean"
    },
    "winner": {
      "type": [
        "string",
        "null"
      ]
    },
    "endReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentLang": {
      "type": "string",
      "enum": [
        "en",
        "es"
      ]
    },
    "phoneOnly": {
      "type": "boolean"
    }
  },
  "required": [
    "phase",
    "phaseClock",
    "rng",
    "players",
    "order",
    "settings",
    "board",
    "variant",
    "side",
    "quietPlies",
    "ply",
    "repetition",
    "drawWindows",
    "lastMove",
    "moveLog",
    "left",
    "autoPaused",
    "winner",
    "endReason",
    "contentLang",
    "phoneOnly"
  ],
  "additionalProperties": false
}
