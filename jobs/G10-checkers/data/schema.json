{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "generated"
        },
        "maximumPieces": {
          "type": "number",
          "const": 6
        },
        "completeMaterialClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partialMaterialClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fullSixPieceCoverage": {
          "type": "boolean"
        },
        "drawHistoryIncluded": {
          "type": "boolean",
          "const": false
        },
        "unresolved": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "maximumPieces",
        "completeMaterialClasses",
        "partialMaterialClasses",
        "fullSixPieceCoverage",
        "drawHistoryIncluded",
        "unresolved"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "properties": {
        "american": {
          "type": "object",
          "properties": {
            "positions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "edges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "wins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "losses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "draws": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumDtm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tacticalThreeToSix": {
              "type": "object",
              "properties": {
                "candidates": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "accepted": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "definition": {
                  "type": "string"
                }
              },
              "required": [
                "candidates",
                "accepted",
                "definition"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "positions",
            "edges",
            "wins",
            "losses",
            "draws",
            "maximumDtm",
            "tacticalThreeToSix"
          ],
          "additionalProperties": false
        },
        "international": {
          "type": "object",
          "properties": {
            "positions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "edges": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "wins": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "losses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "draws": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maximumDtm": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tacticalThreeToSix": {
              "type": "object",
              "properties": {
                "candidates": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "accepted": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "definition": {
                  "type": "string"
                }
              },
              "required": [
                "candidates",
                "accepted",
                "definition"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "positions",
            "edges",
            "wins",
            "losses",
            "draws",
            "maximumDtm",
            "tacticalThreeToSix"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "american",
        "international"
      ],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^(american|international):(-1|1):[0-4]+$"
          },
          {
            "type": "integer",
            "minimum": -1,
            "maximum": 1
          },
          {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      }
    }
  },
  "required": [
    "version",
    "seed",
    "coverage",
    "stats",
    "rows"
  ],
  "additionalProperties": false
}
