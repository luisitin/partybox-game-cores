{
  "type": "object",
  "required": [
    "schemaVersion",
    "pieces",
    "canonicalClasses",
    "completeSourceSet",
    "chunkBytes",
    "dataPermissionUrl",
    "dataPermission",
    "scope",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pieces": {
      "const": 6
    },
    "canonicalClasses": {
      "const": 37
    },
    "completeSourceSet": {
      "const": true
    },
    "chunkBytes": {
      "const": 25165824
    },
    "dataPermissionUrl": {
      "const": "https://damforum.nl/bb3/viewtopic.php?t=8341"
    },
    "dataPermission": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "items": {
        "type": "object",
        "required": [
          "name",
          "originalFile",
          "bytes",
          "sha256",
          "installerSha1",
          "originalDriverCrc32",
          "index",
          "chunks"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^db6-[0-5]{4}$"
          },
          "originalFile": {
            "type": "string",
            "pattern": "^db6-[0-5]{4}\\.cpr1$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "installerSha1": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "originalDriverCrc32": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}$"
          },
          "index": {
            "type": "object",
            "required": [
              "file",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^db6-[0-5]{4}\\.idx$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "bytes",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^db6-[0-5]{4}\\.[0-9]{3}\\.chunk$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 25165824
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
