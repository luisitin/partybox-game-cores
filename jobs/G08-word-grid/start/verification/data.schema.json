{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://partybox.invalid/shake-up-data.schema.json",
  "definitions": {
    "words": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z\u00f1]{3,26}$"
      },
      "uniqueItems": true
    },
    "bots": {
      "type": "object",
      "required": [
        "easy",
        "normal",
        "sharp"
      ],
      "additionalProperties": false,
      "properties": {
        "easy": {
          "$ref": "#/definitions/words"
        },
        "normal": {
          "$ref": "#/definitions/words"
        },
        "sharp": {
          "$ref": "#/definitions/words"
        }
      }
    },
    "cube": {
      "type": "object",
      "required": [
        "id",
        "faces"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "faces": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^(Qu|[A-Z\u00d1])$"
          }
        }
      }
    },
    "cubes": {
      "type": "object",
      "required": [
        "lang",
        "source",
        "sets"
      ],
      "additionalProperties": false,
      "properties": {
        "lang": {
          "enum": [
            "en",
            "es"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sets": {
          "type": "object",
          "required": [
            "4x4",
            "5x5"
          ],
          "additionalProperties": false,
          "properties": {
            "4x4": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "$ref": "#/definitions/cube"
              }
            },
            "5x5": {
              "type": "array",
              "minItems": 25,
              "maxItems": 25,
              "items": {
                "$ref": "#/definitions/cube"
              }
            }
          }
        }
      }
    },
    "translations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "original": {
      "type": "object",
      "minProperties": 116,
      "maxProperties": 116,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "id",
        "startedAt",
        "deadline"
      ],
      "properties": {
        "id": {
          "enum": [
            "shake",
            "hunt",
            "reveal",
            "tally",
            "done"
          ]
        },
        "startedAt": {
          "type": "number"
        },
        "deadline": {
          "type": [
            "number",
            "null"
          ]
        },
        "paused": {
          "type": "object",
          "required": [
            "at"
          ],
          "properties": {
            "at": {
              "type": "number"
            }
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "required": [
        "phase",
        "rng",
        "players",
        "cfg",
        "round",
        "order",
        "grid",
        "botPlans",
        "scores",
        "log",
        "words",
        "submissionBytes"
      ],
      "properties": {
        "phase": {
          "$ref": "#/definitions/phase"
        },
        "rng": {
          "type": "object",
          "required": [
            "seed",
            "step"
          ],
          "properties": {
            "seed": {
              "type": "integer"
            },
            "step": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "grid": {
          "type": "array",
          "minItems": 16,
          "maxItems": 25,
          "items": {
            "type": "string",
            "pattern": "^(qu|[a-z\u00f1])$"
          }
        },
        "order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "submissionBytes": {
          "type": "number",
          "minimum": 0,
          "maximum": 98304
        },
        "players": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16
        },
        "words": {
          "type": "object"
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "botPlans": {
          "type": "object",
          "required": [
            "easy",
            "normal",
            "sharp"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "log": {
          "type": "array",
          "maxItems": 5
        },
        "cfg": {
          "type": "object",
          "required": [
            "rounds",
            "huntMs",
            "size",
            "minLen",
            "spicy",
            "lang",
            "dictionary",
            "reader",
            "mode"
          ],
          "properties": {
            "rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "size": {
              "enum": [
                4,
                5
              ]
            },
            "lang": {
              "enum": [
                "en",
                "es"
              ]
            },
            "dictionary": {
              "enum": [
                "full",
                "common"
              ]
            },
            "spicy": {
              "type": "boolean"
            },
            "huntMs": {
              "enum": [
                90000,
                120000,
                180000,
                240000
              ]
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "name",
        "group",
        "title",
        "description",
        "source",
        "forms",
        "licence",
        "usedBy"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "group": {
          "const": "shake-up"
        },
        "licence": {
          "const": "own work"
        },
        "forms": {
          "type": "object",
          "required": [
            "film",
            "station",
            "game"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "usedBy": {
          "type": "array",
          "items": {
            "const": "shake-up"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lang",
          "size",
          "origin",
          "faces"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "lang": {
            "enum": [
              "en",
              "es"
            ]
          },
          "size": {
            "enum": [
              4,
              5
            ]
          },
          "origin": {
            "type": "string"
          },
          "faces": {
            "type": "array",
            "minItems": 16,
            "maxItems": 25,
            "items": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "string",
                "pattern": "^(qu|[a-z\u00f1])$"
              }
            }
          }
        }
      }
    },
    "receipts": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": [
              "repo",
              "path",
              "commit",
              "url",
              "readUtc",
              "bytes",
              "sha256",
              "use"
            ],
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "const": 1
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "minPlayers",
        "maxPlayers",
        "version",
        "settings"
      ],
      "properties": {
        "id": {
          "const": "shake-up"
        },
        "minPlayers": {
          "const": 1
        },
        "maxPlayers": {
          "const": 16
        },
        "settings": {
          "type": "array"
        },
        "name": {
          "const": "Shake Up"
        }
      }
    }
  }
}
