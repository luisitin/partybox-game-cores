{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "accepted-nine-plural-pairs-two-eight-seats-v1"
    },
    "label": {
      "type": "string",
      "enum": [
        "baseline",
        "after"
      ]
    },
    "assumption": {
      "type": "string"
    },
    "sourceHashes": {
      "type": "object",
      "properties": {
        "core": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "matcher": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scoring": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "data": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "experiment": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "core",
        "matcher",
        "scoring",
        "data",
        "reference",
        "experiment"
      ],
      "additionalProperties": false
    },
    "rows": {
      "minItems": 18,
      "maxItems": 18,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "count": {
            "anyOf": [
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 8
              }
            ]
          },
          "singular": {
            "type": "string"
          },
          "plural": {
            "type": "string"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "letter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "layout": {
            "minItems": 12,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matches": {
            "type": "boolean"
          },
          "publicGroups": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "receipt": {
            "type": "object",
            "properties": {
              "categoryId": {
                "type": "string"
              },
              "groups": {
                "minItems": 1,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "owners": {
                      "minItems": 1,
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "duplicate": {
                      "type": "boolean"
                    },
                    "eligible": {
                      "type": "boolean"
                    },
                    "accepted": {
                      "type": "boolean"
                    },
                    "points": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "owners",
                    "duplicate",
                    "eligible",
                    "accepted",
                    "points"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "categoryId",
              "groups"
            ],
            "additionalProperties": false
          },
          "awarded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "scores": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          },
          "eventCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "replayMatches": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "count",
          "singular",
          "plural",
          "seed",
          "letter",
          "layout",
          "matches",
          "publicGroups",
          "receipt",
          "awarded",
          "scores",
          "eventCount",
          "replayMatches"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol",
    "label",
    "assumption",
    "sourceHashes",
    "rows"
  ],
  "additionalProperties": false
}
