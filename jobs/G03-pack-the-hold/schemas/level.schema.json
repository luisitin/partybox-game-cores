    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "cells": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "crates": {
      "minItems": 6,
      "maxItems": 12,
      "type": "array",
