{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "kind": {
      "type": "string",
      "const": "visual"
    },
    "status": {
      "type": "string",
      "const": "failed"
    },
    "startedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "sourceHashesStart": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "sourceHashesEnd": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "wallClock": {
      "type": "string",
      "const": "Date.now frozen by host; native RAF timestamps unchanged"
    },
    "rawFiltering": {
      "type": "string",
      "const": "none"
    },
    "captureDuringSamples": {
      "type": "boolean",
      "const": false
    },
    "physicalPhoneMeasured": {
      "type": "boolean",
      "const": false
    },
    "desktop": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cpu": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "warmupFrames": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "interaction": {
              "type": "string"
            },
            "frames": {
              "type": "number",
              "const": 900
            },
            "meanMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "p95Ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "overflow": {
              "type": "boolean"
            },
            "profile": {
              "type": "string",
              "enum": [
                "desktop",
                "phone"
              ]
            },
            "p99Ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rawFile": {
              "type": "string"
            }
          },
          "required": [
            "width",
            "height",
            "cpu",
            "warmupFrames",
            "interaction",
            "frames",
            "meanMs",
            "p95Ms",
            "maxMs",
            "fps",
            "overflow",
            "profile",
            "p99Ms",
            "rawFile"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "phone": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "cpu": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "warmupFrames": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "interaction": {
              "type": "string"
            },
            "frames": {
              "type": "number",
              "const": 900
            },
            "meanMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "p95Ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "overflow": {
              "type": "boolean"
            },
            "profile": {
              "type": "string",
              "enum": [
                "desktop",
                "phone"
              ]
            },
            "p99Ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rawFile": {
              "type": "string"
            }
          },
          "required": [
            "width",
            "height",
            "cpu",
            "warmupFrames",
            "interaction",
            "frames",
            "meanMs",
            "p95Ms",
            "maxMs",
            "fps",
            "overflow",
            "profile",
            "p99Ms",
            "rawFile"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "type": "string"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "minItems": 0,
      "maxItems": 0,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documentUrl": {
      "type": "string"
    },
    "chrome": {
      "type": "string"
    },
    "fileOpened": {
      "type": "boolean"
    },
    "serving": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "startedAtUtc",
    "finishedAtUtc",
    "sourceHashesStart",
    "sourceHashesEnd",
    "wallClock",
    "rawFiltering",
    "captureDuringSamples",
    "physicalPhoneMeasured",
    "desktop",
    "phone",
    "failure",
    "requests",
    "errors",
    "documentUrl"
  ],
  "additionalProperties": false
}
