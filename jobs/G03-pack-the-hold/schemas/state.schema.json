{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "phase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "pack",
            "reveal",
            "done"
          ]
        },
        "startedAt": {
          "type": "number"
        },
        "deadline": {
          "type": [
            "number",
            "null"
          ]
        },
        "paused": {
          "type": "object",
          "properties": {
            "at": {
              "type": "number"
            }
          },
          "required": [
            "at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "startedAt",
        "deadline"
      ],
      "additionalProperties": false
    },
    "rng": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seed",
        "step"
      ],
      "additionalProperties": false
    },
    "players": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarId": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          },
          "bot": {
            "type": "boolean"
          },
          "canSeeTv": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "avatarId",
          "connected"
        ],
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "turnSeconds": {
          "type": "integer",
          "minimum": 20,
          "maximum": 60
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "allowFlip": {
          "type": "boolean"
        }
      },
      "required": [
        "rounds",
        "turnSeconds",
        "difficulty",
        "allowFlip"
      ],
      "additionalProperties": false
    },
    "order": {
      "minItems": 2,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "left": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "seat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "level": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "cells": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "crates": {
          "minItems": 6,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "cells": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 63
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 63
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "value": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "cells",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "allowFlip": {
          "type": "boolean"
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "width",
        "height",
        "cells",
        "crates",
        "allowFlip",
        "difficulty"
      ],
      "additionalProperties": false
    },
    "optimum": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "solution": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "crateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "x": {
            "type": "integer",
            "minimum": -64,
            "maximum": 64
          },
          "y": {
            "type": "integer",
            "minimum": -64,
            "maximum": 64
          },
          "rotation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        },
        "required": [
          "crateId",
          "x",
          "y",
          "rotation"
        ],
        "additionalProperties": false
      }
    },
    "layouts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "maxItems": 12,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "crateId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "x": {
              "type": "integer",
              "minimum": -64,
              "maximum": 64
            },
            "y": {
              "type": "integer",
              "minimum": -64,
              "maximum": 64
            },
            "rotation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "required": [
            "crateId",
            "x",
            "y",
            "rotation"
          ],
          "additionalProperties": false
        }
      }
    },
    "submitted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scores": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "history": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "optimum": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "value",
            "optimum",
            "ratio"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "phase",
    "rng",
    "players",
    "settings",
    "order",
    "left",
    "round",
    "seat",
    "level",
    "optimum",
    "solution",
    "layouts",
    "submitted",
    "scores",
    "history"
  ],
  "additionalProperties": false
}
