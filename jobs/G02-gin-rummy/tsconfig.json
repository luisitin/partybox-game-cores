  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "resolveJsonModule": true, "allowSyntheticDefaultImports": true,
